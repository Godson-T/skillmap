# Copy to .env (never commit .env). Server-side only: none of these use the VITE_ prefix,
# so they are never bundled into the browser build.

# ── Required ────────────────────────────────────────────────────────────────
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# ── LLM (optional) ──────────────────────────────────────────────────────────
# Defaults to openai/gpt-oss-120b (a Groq Production model). Preview models such as
# qwen/qwen3.8-27b work but Groq may remove them at short notice.
GROQ_MODEL=openai/gpt-oss-120b
# Per-attempt timeout in ms (one retry is made only for invalid model output).
LLM_TIMEOUT_MS=20000
# Completion budget including reasoning tokens.
LLM_MAX_TOKENS=6000

# ── CORS (optional) ─────────────────────────────────────────────────────────
# Same-origin requests are always allowed (production, preview and local dev).
# List extra origins that may call the API cross-origin, comma-separated, exact match.
ALLOWED_ORIGINS=

# ── Rate limiting (optional, strongly recommended in production) ────────────
# Without Redis, limits are kept in memory per serverless instance only.
# Upstash Redis REST credentials (Vercel Marketplace Redis/KV exposes KV_REST_API_URL / KV_REST_API_TOKEN, also accepted).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Per client IP (hashed, never stored raw)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=40
# Global cap on successful-quota analyses per UTC day (budget guard)
DAILY_REQUEST_CAP=2000
# Salt for hashing client IPs into rate-limit keys
RATE_LIMIT_SALT=change-me
