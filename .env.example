# Copy to .env (never commit .env). Server-side only: none of these use the VITE_ prefix,
# so they are never bundled into the browser build.

# ── Required ────────────────────────────────────────────────────────────────
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# ── LLM (optional) ──────────────────────────────────────────────────────────
# Defaults to openai/gpt-oss-120b (a Groq Production model). Preview models such as
# qwen/qwen3.8-27b work but Groq may remove them at short notice.
GROQ_MODEL=openai/gpt-oss-120b
# Per-attempt timeout in ms, clamped to 1000-30000. One retry is made only for invalid
# or truncated model output, and both attempts share a 50 s overall deadline.
LLM_TIMEOUT_MS=20000
# Completion budget including reasoning tokens, clamped to 512-12000. A truncated reply
# is retried once with 1.5x this budget.
LLM_MAX_TOKENS=6000

# ── CORS (optional) ─────────────────────────────────────────────────────────
# Same-origin requests are always allowed (production, preview and local dev).
# List extra origins that may call the API cross-origin, comma-separated, exact match.
ALLOWED_ORIGINS=

# ── Proxy (optional) ────────────────────────────────────────────────────────
# Client IPs come from X-Forwarded-For / X-Real-IP only on Vercel (detected via VERCEL)
# or when this is set, because those headers are otherwise client-controlled.
# Set to true ONLY behind a reverse proxy that overwrites them.
TRUST_PROXY=

# ── Rate limiting (optional, strongly recommended in production) ────────────
# Without Redis, limits are kept in memory per serverless instance only.
# Upstash Redis REST credentials (Vercel Marketplace Redis/KV exposes KV_REST_API_URL / KV_REST_API_TOKEN, also accepted).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Per client IP (hashed, never stored raw)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=40
# Global cap on successful-quota analyses per UTC day (budget guard)
DAILY_REQUEST_CAP=2000
# /api/market (live job-posting data) has its own per-IP limits and does not count toward DAILY_REQUEST_CAP
MARKET_RATE_LIMIT_PER_MINUTE=10
MARKET_RATE_LIMIT_PER_DAY=200
# Global cap while Redis is configured but unreachable. Limits then fall back to
# per-instance memory, so this is kept low.
DEGRADED_DAILY_CAP=100
# Salt for hashing client IPs into rate-limit keys. Required in production: without it
# an error is logged at startup, because hashed keys of known IPs become guessable.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RATE_LIMIT_SALT=change-me
